# Local development defaults. Copy to apps/web/.env and replace placeholders.
# Every VITE_ variable is PUBLIC / CLIENT-SAFE and will be bundled into the browser.
# Never put OpenAI keys, DATABASE_URL, Firebase service accounts, or other secrets here.

# Required in production. Local default is the API on port 3001.
# Production: the public Railway API origin, for example https://your-api.up.railway.app
VITE_API_URL=http://localhost:3001

# Firebase web app config. These values are public client identifiers, not Admin secrets.
# Restrict them in the Firebase console to the production domain.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
