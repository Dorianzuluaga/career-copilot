PORT=3001
DATABASE_URL=postgresql://username:password@localhost:5432/career_copilot
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Required for Master CV PDF extraction. Keep this value server-side.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional. Master CV extraction defaults to gpt-4.1-mini when omitted.
OPENAI_MODEL=gpt-4.1-mini
