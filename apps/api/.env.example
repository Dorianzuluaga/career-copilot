# Local development defaults. Copy to apps/api/.env and replace placeholders.
# Never put real secrets in this file. All of these values are SERVER-ONLY.

NODE_ENV=development
PORT=3001

# Required. PostgreSQL connection string. SERVER-ONLY / SECRET.
DATABASE_URL=postgresql://username:password@localhost:5432/career_copilot

# Required. Allowed frontend origin for CORS. Not a secret, but server-only config.
# Local: http://localhost:5173
# Production: the exact Railway Web origin, for example https://your-web.up.railway.app
FRONTEND_ORIGIN=http://localhost:5173

# Firebase Admin credentials. Provide ONE of the following. SERVER-ONLY / SECRET.
# Local: path to the Firebase service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Production (Railway): paste the full service account JSON as a single value.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project"}

# Required for Master CV extraction, Job Analysis, and other AI features. SERVER-ONLY / SECRET.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional. AI extraction defaults to gpt-4.1-mini when omitted. SERVER-ONLY.
OPENAI_MODEL=gpt-4.1-mini
